	month = jan,
	year = {2016},
	keywords = {Electronic properties and materials, Phase transitions and critical phenomena, Superconducting properties and materials, Two-dimensional materials},
	pages = {92--97},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/BBZA9PDB/Ugeda et al. - 2016 - Characterization of collective ground states in si.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/3MMIDG9H/nphys3527.html:text/html}
