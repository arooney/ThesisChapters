	keywords = {CharHeteros, Xsection},
	pages = {6936--6941},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/UK2FD3MN/Lin et al. - 2014 - Atomically Thin Heterostructures Based on Single-L.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/TS2ZKJJ4/nl503144a.html:text/html}
