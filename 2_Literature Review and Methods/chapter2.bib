@article{avouris2012graphene,
	title = {Graphene: synthesis and applications},
	volume = {15},
	issn = {1369-7021},
	shorttitle = {Graphene},
	url = {http://www.sciencedirect.com/science/article/pii/S1369702112700445},
	doi = {10.1016/S1369-7021(12)70044-5},
	abstract = {Graphene, since the demonstration of its easy isolation by the exfoliation of graphite in 2004 by Novoselov, Geim and co-workers, has been attracting enormous attention in the scientific community. Because of its unique properties, high hopes have been placed on it for technological applications in many areas. Here we will briefly review aspects of two of these application areas: analog electronics and photonics/optoelectronics. We will discuss the relevant material properties, device physics, and some of the available results. Of course, we cannot rely on graphite exfoliation as the source of graphene for technological applications, so we will start by introducing large scale graphene growth techniques.},
	number = {3},
	urldate = {2016-08-09},
	journal = {Materials Today},
	author = {Avouris, Phaedon and Dimitrakopoulos, Christos},
	month = mar,
