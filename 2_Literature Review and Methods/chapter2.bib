@article{kempshall2001ionchanneling,
	title = {Ion channeling effects on the focused ion beam milling of {Cu}},
	volume = {19},
	issn = {2166-2746, 2166-2754},
	url = {http://scitation.aip.org/content/avs/journal/jvstb/19/3/10.1116/1.1368670},
	doi = {10.1116/1.1368670},
	abstract = {The use of focused ion beam(FIB) instruments for device modification and specimen preparation has become a mainstay in the microelectronics industry and in thin film characterization. The role of the FIB as a tool to rapidly prepare high quality transmission electron microscopy specimens is particularly significant. Special attention has been given to FIBmilling of Cu and Si in the microelectronics arena. Although FIB applications involving Si have been extremely successful, it has been noted that Cu tends to present significant challenges to FIBmilling because of effects such as the development of milling induced topographical features. We show evidence that links the occurrence of milling induced topography to the severity of redeposition. Specifically, Cu, which sputters \~{}2.5 times faster than Si, exhibits an increased susceptibility to redeposition related artifacts. In addition, the effects and the mechanism of Ga + channeling in Cu is used to illustrate that Ga + channeling reduces the sputtering yield, improves the quality of FIB mill cuts, and improves the surface characteristics of FIB milled Cu. Finally, a technique for improving FIBmilling across grain boundaries or interfaces using ion channeling contrast is suggested.},
	number = {3},
	urldate = {2016-01-06},
	journal = {Journal of Vacuum Science \& Technology B},
	author = {Kempshall, B. W. and Schwarz, S. M. and Prenitzer, B. I. and Giannuzzi, L. A. and Irwin, R. B. and Stevie, F. A.},
	month = may,
	year = {2001},
	keywords = {Copper, Focused ion beam technology, Microelectronics, Milling, Thin film devices},
	pages = {749--754},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9VN73QUS/Kempshall et al. - 2001 - Ion channeling effects on the focused ion beam mil.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/JUV3Z35H/Kempshall et al. - 2001 - Ion channeling effects on the focused ion beam mil.html:text/html}
}

@article{wang2005surface,
	series = {The 9th {International} {Symposium} on {Advanced} {Physical} {Fields}},
	title = {Surface damage induced by focused-ion-beam milling in a {Si}/{Si} p{\textendash}n junction cross-sectional specimen},
	volume = {241},
	issn = {0169-4332},
	url = {http://www.sciencedirect.com/science/article/pii/S0169433204013704},
	doi = {10.1016/j.apsusc.2004.09.092},
	abstract = {Focused-ion-beam (FIB) technique has been widely used to prepare device specimen for transmission electron microscopy (TEM)-based microanalysis. One artifact induced by high-energy FIB milling is surface damage in the specimen. We systematically studied the damaged amorphous layers induced by gallium FIBs with different energies in Si/Si p{\textendash}n junction cross-sectional specimens. The damaged amorphous layers in the top surface during depositing protective layers by 30 and 40 keV FIBs were measured to be 48 and 65 nm thick, respectively. In the sidewall, the amorphous layers were observed to be 9.4, 14.5, 20.0 and 25.3 nm, respectively, for the 10, 20, 30 and 40 keV FIB milling. In the n- and p-type side of the p{\textendash}n junction, no difference was observed for the sidewall amorphous layers. A comparison shows the top surface and the sidewall amorphous layers can be estimated simply by formulae Rp + n{\textperiodcentered}$\Delta$Rp and n{\textperiodcentered}$\Delta$Rt by taking n = 3. Our experimental results suggest that the sidewall damage can be reduced largely by using a low-energy FIB at final milling step.},
	number = {1{\textendash}2},
	urldate = {2016-08-15},
	journal = {Applied Surface Science},
	author = {Wang, Zhouguang and Kato, Takeharu and Hirayama, Tsukasa and Kato, Naoko and Sasaki, Katsuhiro and Saka, Hiroyasu},
	month = feb,
	year = {2005},
	keywords = {Damage effect, FIB, Sample preparation, TEM, Xsection},
	pages = {80--86},
	file = {ScienceDirect Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/5X7SZZNP/Wang et al. - 2005 - Surface damage induced by focused-ion-beam milling.pdf:application/pdf;ScienceDirect Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/KJ3WQNXK/S0169433204013704.html:text/html}
}

