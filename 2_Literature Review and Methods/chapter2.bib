	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/2S567T7K/Li et al. - 2013 - Probing Symmetry Properties of Few-Layer MoS2 and .pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/62GM6HXF/nl401561r.html:text/html}
}

@article{kim2013stacking,
	title = {Stacking {Order} {Dependent} {Second} {Harmonic} {Generation} and {Topological} {Defects} in h-{BN} {Bilayers}},
	volume = {13},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl403328s},
	doi = {10.1021/nl403328s},
	abstract = {The ability to control the stacking structure in layered materials could provide an exciting approach to tuning their optical and electronic properties. Because of the lower symmetry of each constituent monolayer, hexagonal boron nitride (h-BN) allows more structural variations in multiple layers than graphene; however, the structure{\textendash}property relationships in this system remain largely unexplored. Here, we report a strong correlation between the interlayer stacking structures and optical and topological properties in chemically grown h-BN bilayers, measured mainly by using dark-field transmission electron microscopy (DF-TEM) and optical second harmonic generation (SHG) mapping. Our data show that there exist two distinct h-BN bilayer structures with different interlayer symmetries that give rise to a distinct difference in their SHG intensities. In particular, the SHG signal in h-BN bilayers is observed only for structures with broken inversion symmetry, with an intensity much larger than that of single layer h-BN. In addition, our DF-TEM data identify the formation of interlayer topological defects in h-BN bilayers, likely induced by local strain, whose properties are determined by the interlayer symmetry and the different interlayer potential landscapes.},
	number = {11},
	urldate = {2016-09-12},
	journal = {Nano Letters},
	author = {Kim, Cheol-Joo and Brown, Lola and Graham, Matt W. and Hovden, Robert and Havener, Robin W. and McEuen, Paul L. and Muller, David A. and Park, Jiwoong},
	month = nov,
	year = {2013},
	pages = {5660--5665},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/C3CPM2BT/Kim et al. - 2013 - Stacking Order Dependent Second Harmonic Generatio.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/PUNR7ZF5/nl403328s.html:text/html}
}

@article{michalowski2016secondary,
