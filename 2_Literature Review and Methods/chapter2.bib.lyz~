	keywords = {Two-dimensional materials},
	pages = {765--769},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/TRN3H9UQ/Xi et al. - 2015 - Strongly enhanced charge-density-wave order in mon.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9BM2E7G7/nnano.2015.143.html:text/html}
