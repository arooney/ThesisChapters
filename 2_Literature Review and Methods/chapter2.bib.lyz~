	url = {http://www.nature.com/nmat/journal/v14/n9/full/nmat4356.html},
	doi = {10.1038/nmat4356},
	abstract = {Atomically thin two-dimensional crystals have revolutionized materials science. In particular, monolayer transition metal dichalcogenides promise novel optoelectronic applications, owing to their direct energy gaps in the optical range. Their electronic and optical properties are dominated by Coulomb-bound electron{\textendash}hole pairs called excitons, whose unusual internal structure, symmetry, many-body effects and dynamics have been vividly discussed. Here we report the first direct experimental access to all 1s A excitons, regardless of momentum{\textemdash}inside and outside the radiative cone{\textemdash}in single-layer WSe2. Phase-locked mid-infrared pulses reveal the internal orbital 1s{\textendash}2p resonance, which is highly sensitive to the shape of the excitonic envelope functions and provides accurate transition energies, oscillator strengths, densities and linewidths. Remarkably, the observed decay dynamics indicates an ultrafast radiative annihilation of small-momentum excitons within 150 fs, whereas Auger recombination prevails for optically dark states. The results provide a comprehensive view of excitons and introduce a new degree of freedom for quantum control, optoelectronics and valleytronics of dichalcogenide monolayers.},
	language = {en},
	number = {9},
	urldate = {2016-08-20},
	journal = {Nature Materials},
	author = {Poellmann, C. and Steinleitner, P. and Leierseder, U. and Nagler, P. and Plechinger, G. and Porer, M. and Bratschitsch, R. and Sch{\"u}ller, C. and Korn, T. and Huber, R.},
	month = sep,
	year = {2015},
	keywords = {Electronic properties and materials, interfaces and thin films, Surfaces, Two-dimensional materials},
	pages = {889--893},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9EXXG4KA/Poellmann et al. - 2015 - Resonant internal quantum transitions and femtosec.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/A88FIT7H/nmat4356.html:text/html}
}

@article{xiao2012coupled,
	title = {Coupled {Spin} and {Valley} {Physics} in {Monolayers} of \$\{{\textbackslash}mathrm\{{MoS}\}\}\_\{2\}\$ and {Other} {Group}-{VI} {Dichalcogenides}},
	volume = {108},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.108.196802},
	doi = {10.1103/PhysRevLett.108.196802},
	abstract = {We show that inversion symmetry breaking together with spin-orbit coupling leads to coupled spin and valley physics in monolayers of MoS2 and other group-VI dichalcogenides, making possible controls of spin and valley in these 2D materials. The spin-valley coupling at the valence-band edges suppresses spin and valley relaxation, as flip of each index alone is forbidden by the valley-contrasting spin splitting. Valley Hall and spin Hall effects coexist in both electron-doped and hole-doped systems. Optical interband transitions have frequency-dependent polarization selection rules which allow selective photoexcitation of carriers with various combination of valley and spin indices. Photoinduced spin Hall and valley Hall effects can generate long lived spin and valley accumulations on sample boundaries. The physics discussed here provides a route towards the integration of valleytronics and spintronics in multivalley materials with strong spin-orbit coupling and inversion symmetry breaking.},
	number = {19},
	urldate = {2016-08-20},
	journal = {Physical Review Letters},
	author = {Xiao, Di and Liu, Gui-Bin and Feng, Wanxiang and Xu, Xiaodong and Yao, Wang},
