	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/AVSUPE2J/Wang et al. - 2016 - Fabrication and In Situ Transmission Electron Micr.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/7MA6DKHW/acsnano.html:text/html}
}

