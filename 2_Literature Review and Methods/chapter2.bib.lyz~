	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/J7KTPAMH/Lopez-Sanchez et al. - 2013 - Ultrasensitive photodetectors based on monolayer M.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/GV3EIU9D/nnano.2013.100.html:text/html}
