@article{guinea2010energygaps,
	title = {Energy gaps and a zero-field quantum {Hall} effect in graphene by strain engineering},
	volume = {6},
	copyright = {{\textcopyright} 2009 Nature Publishing Group},
	issn = {1745-2473},
	url = {http://www.nature.com/nphys/journal/v6/n1/abs/nphys1420.html},
	doi = {10.1038/nphys1420},
	abstract = {Among many remarkable qualities of graphene, its electronic properties attract particular interest owing to the chiral character of the charge carriers, which leads to such unusual phenomena as metallic conductivity in the limit of no carriers and the half-integer quantum Hall effect observable even at room temperature. Because graphene is only one atom thick, it is also amenable to external influences, including mechanical deformation. The latter offers a tempting prospect of controlling graphene{\textquoteright}s properties by strain and, recently, several reports have examined graphene under uniaxial deformation. Although the strain can induce additional Raman features, no significant changes in graphene{\textquoteright}s band structure have been either observed or expected for realistic strains of up to {\textasciitilde}15\% (refs 9, 10, 11). Here we show that a designed strain aligned along three main crystallographic directions induces strong gauge fields that effectively act as a uniform magnetic field exceeding 10 T. For a finite doping, the quantizing field results in an insulating bulk and a pair of countercirculating edge states, similar to the case of a topological insulator. We suggest realistic ways of creating this quantum state and observing the pseudomagnetic quantum Hall effect. We also show that strained superlattices can be used to open significant energy gaps in graphene{\textquoteright}s electronic spectrum.},
	language = {en},
	number = {1},
	urldate = {2016-08-05},
	journal = {Nature Physics},
	author = {Guinea, F. and Katsnelson, M. I. and Geim, A. K.},
	month = jan,
	year = {2010},
	pages = {30--33},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/TUWTSD5S/Guinea et al. - 2010 - Energy gaps and a zero-field quantum Hall effect i.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/P7GVA46U/nphys1420.html:text/html}
}

