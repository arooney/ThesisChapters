}

@article{nikiforov2012nanoscale,
	title = {Nanoscale {Bending} of {Multilayered} {Boron} {Nitride} and {Graphene} {Ribbons}: {Experiment} and {Objective} {Molecular} {Dynamics} {Calculations}},
	volume = {109},
	shorttitle = {Nanoscale {Bending} of {Multilayered} {Boron} {Nitride} and {Graphene} {Ribbons}},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.109.025504},
	doi = {10.1103/PhysRevLett.109.025504},
	abstract = {By combining experiments performed on nanoribbons in situ within a high-resolution TEM with objective molecular dynamics simulations, we reveal common mechanisms in the bending response of few-layer-thick hexagonal boron nitride and graphene nanoribbons. Both materials are observed forming localized kinks in the fully reversible bending experiments. Microscopic simulations and theoretical analysis indicate platelike bending behavior prior to kinking, in spite of the possibility of interlayer sliding, and give the critical curvature for the kinking onset. This behavior is distinct from the rippling and kinking of multi- and single-wall nanotubes under bending. Our findings have implications for future study of nanoscale layered materials, including nanomechanical device design.},
	number = {2},
	urldate = {2016-04-15},
	journal = {Physical Review Letters},
	author = {Nikiforov, Ilia and Tang, Dai-Ming and Wei, Xianlong and Dumitric{\v a}, Traian and Golberg, Dmitri},
	month = jul,
	year = {2012},
	pages = {025504},
	file = {APS Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/EWVMW9BS/PhysRevLett.109.html:text/html;Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/N674DJG4/Nikiforov et al. - 2012 - Nanoscale Bending of Multilayered Boron Nitride an.pdf:application/pdf}
}

@article{tang2014nanomechanical,
	title = {Nanomechanical cleavage of molybdenum disulphide atomic layers},
	volume = {5},
	copyright = {{\textcopyright} 2014 Nature Publishing Group, a division of Macmillan Publishers Limited. All Rights Reserved.},
	url = {http://www.nature.com/ncomms/2014/140403/ncomms4631/full/ncomms4631.html},
	doi = {10.1038/ncomms4631},
	abstract = {The discovery of two-dimensional materials became possible due to the mechanical cleavage technique. Despite its simplicity, the as-cleaved materials demonstrated surprising macro-continuity, high crystalline quality and extraordinary mechanical and electrical properties that triggered global research interest. Here such cleavage processes and associated mechanical behaviours are investigated by a direct in situ transmission electron microscopy probing technique, using atomically thin molybdenum disulphide layers as a model material. Our technique demonstrates layer number selective cleavage, from a monolayer to double layer and up to 23 atomic layers. In situ observations combined with molecular dynamics simulations reveal unique layer-dependent bending behaviours, from spontaneous rippling ({\textless}5 atomic layers) to homogeneous curving ({\textasciitilde} 10 layers) and finally to kinking (20 or more layers), depending on the competition of strain energy and interfacial energy.},
	language = {en},
	urldate = {2016-03-17},
	journal = {Nature Communications},
	author = {Tang, Dai-Ming and Kvashnin, Dmitry G. and Najmaei, Sina and Bando, Yoshio and Kimoto, Koji and Koskinen, Pekka and Ajayan, Pulickel M. and Yakobson, Boris I. and Sorokin, Pavel B. and Lou, Jun and Golberg, Dmitri},
	month = apr,
	year = {2014},
	keywords = {Biological sciences, Materials science},
	pages = {3631},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/XCCMBD2E/Tang et al. - 2014 - Nanomechanical cleavage of molybdenum disulphide a.pdf:application/pdf;Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/3G8HGKU3/Tang et al. - 2014 - Nanomechanical cleavage of molybdenum disulphide a.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/7VTMEMT2/ncomms4631.html:text/html;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/2M49WXUR/ncomms4631.html:text/html}
}

@article{oviedo2015insitu,
	title = {In {Situ} {TEM} {Characterization} of {Shear}-{Stress}-{Induced} {Interlayer} {Sliding} in the {Cross} {Section} {View} of {Molybdenum} {Disulfide}},
	volume = {9},
	issn = {1936-0851},
	url = {http://dx.doi.org/10.1021/nn506052d},
	doi = {10.1021/nn506052d},
	abstract = {The experimental study of interlayer sliding at the nanoscale in layered solids has been limited thus far by the incapability of mechanical and imaging probes to simultaneously access sliding interfaces and overcome through mechanical stimulus the van der Waals and Coulombic interactions holding the layers in place. For this purpose, straightforward methods were developed to achieve interlayer sliding in molybdenum disulfide (MoS2) while under observation within a transmission electron microscope. A method to manipulate, tear, and slide free-standing atomic layers of MoS2 is demonstrated by electrostatically coupling it to an oxidized tungsten probe attached to a micromanipulator at a bias above {\textpm}7 V. A first-principles model of a MoS2 bilayer polarized by a normal electric field of 5 V/nm, emanating from the tip, demonstrates the appearance of a periodic negative sliding potential energy barrier when the layers slide into the out-of-registry stacking configuration, hinting at electrostatic gating as a means of modifying the interlayer tribology to facilitate shear exfoliation. A method to shear focused ion beam prepared MoS2 cross section samples using a nanoindenter force sensor is also demonstrated, allowing both the observation and force measurement of its interlayer dynamics during shear-induced sliding. From this experiment, the zero normal load shear strength of MoS2 can be directly obtained: 25.3 {\textpm} 0.6 MPa. These capabilities enable the site-specific mechanical testing of dry lubricant-based nanoelectromechanical devices and can lead to a better understanding of the atomic mechanisms from which the interlayer tribology of layered materials originates.},
	number = {2},
	urldate = {2016-08-21},
	journal = {ACS Nano},
	author = {Oviedo, Juan Pablo and KC, Santosh and Lu, Ning and Wang, Jinguo and Cho, Kyeongjae and Wallace, Robert M. and Kim, Moon J.},
	month = feb,
	year = {2015},
	keywords = {Sliding, Xsection},
	pages = {1543--1551},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/M5MJWH5H/Oviedo et al. - 2015 - In Situ TEM Characterization of Shear-Stress-Induc.pdf:application/pdf;ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/WW7GW5E6/Oviedo et al. - 2015 - In Situ TEM Characterization of Shear-Stress-Induc.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/8QIUUGUC/nn506052d.html:text/html;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/R4VVV263/nn506052d.html:text/html}
}

@article{cui2015multiterminal,
	title = {Multi-terminal transport measurements of {MoS}2 using a van der {Waals} heterostructure device platform},
	volume = {10},
	copyright = {{\textcopyright} 2015 Nature Publishing Group},
	issn = {1748-3387},
	url = {http://www.nature.com/nnano/journal/v10/n6/full/nnano.2015.70.html},
	doi = {10.1038/nnano.2015.70},
	abstract = {Atomically thin two-dimensional semiconductors such as MoS2 hold great promise for electrical, optical and mechanical devices and display novel physical phenomena. However, the electron mobility of mono- and few-layer MoS2 has so far been substantially below theoretically predicted limits, which has hampered efforts to observe its intrinsic quantum transport behaviours. Potential sources of disorder and scattering include defects such as sulphur vacancies in the MoS2 itself as well as extrinsic sources such as charged impurities and remote optical phonons from oxide dielectrics. To reduce extrinsic scattering, we have developed here a van der Waals heterostructure device platform where MoS2 layers are fully encapsulated within hexagonal boron nitride and electrically contacted in a multi-terminal geometry using gate-tunable graphene electrodes. Magneto-transport measurements show dramatic improvements in performance, including a record-high Hall mobility reaching 34,000 cm2 V{\textendash}1 s{\textendash}1 for six-layer MoS2 at low temperature, confirming that low-temperature performance in previous studies was limited by extrinsic interfacial impurities rather than bulk defects in the MoS2. We also observed Shubnikov{\textendash}de Haas oscillations in high-mobility monolayer and few-layer MoS2. Modelling of potential scattering sources and quantum lifetime analysis indicate that a combination of short-range and long-range interfacial scattering limits the low-temperature mobility of MoS2.},
	language = {en},
	number = {6},
	urldate = {2016-09-19},
	journal = {Nature Nanotechnology},
	author = {Cui, Xu and Lee, Gwan-Hyoung and Kim, Young Duck and Arefe, Ghidewon and Huang, Pinshane Y. and Lee, Chul-Ho and Chenet, Daniel A. and Zhang, Xian and Wang, Lei and Ye, Fan and Pizzocchero, Filippo and Jessen, Bjarke S. and Watanabe, Kenji and Taniguchi, Takashi and Muller, David A. and Low, Tony and Kim, Philip and Hone, James},
	month = jun,
	year = {2015},
	keywords = {Electronic devices, Two-dimensional materials, Xsection},
	pages = {534--540},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/ESNPMFFS/Cui et al. - 2015 - Multi-terminal transport measurements of MoS2 usin.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9RSX8B3X/nnano.2015.70.html:text/html}
}

@article{yue2015hfse2thin,
	title = {{HfSe}2 {Thin} {Films}: 2D {Transition} {Metal} {Dichalcogenides} {Grown} by {Molecular} {Beam} {Epitaxy}},
	volume = {9},
	issn = {1936-0851},
	shorttitle = {{HfSe}2 {Thin} {Films}},
	url = {http://dx.doi.org/10.1021/nn5056496},
	doi = {10.1021/nn5056496},
	abstract = {In this work, we demonstrate the growth of HfSe2 thin films using molecular beam epitaxy. The relaxed growth criteria have allowed us to demonstrate layered, crystalline growth without misfit dislocations on other 2D substrates such as highly ordered pyrolytic graphite and MoS2. The HfSe2 thin films exhibit an atomically sharp interface with the substrates used, followed by flat, 2D layers with octahedral (1T) coordination. The resulting HfSe2 is slightly n-type with an indirect band gap of \~{}1.1 eV and a measured energy band alignment significantly different from recent DFT calculations. These results demonstrate the feasibility and significant potential of fabricating 2D material based heterostructures with tunable band alignments for a variety of nanoelectronic and optoelectronic applications.},
	number = {1},
	urldate = {2016-09-19},
	journal = {ACS Nano},
	author = {Yue, Ruoyu and Barton, Adam T. and Zhu, Hui and Azcatl, Angelica and Pena, Luis F. and Wang, Jian and Peng, Xin and Lu, Ning and Cheng, Lanxia and Addou, Rafik and McDonnell, Stephen and Colombo, Luigi and Hsu, Julia W. P. and Kim, Jiyoung and Kim, Moon J. and Wallace, Robert M. and Hinkle, Christopher L.},
	month = jan,
	year = {2015},
	keywords = {Xsection},
	pages = {474--480},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9HDV54BX/Yue et al. - 2015 - HfSe2 Thin Films 2D Transition Metal Dichalcogeni.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/3DMRB68N/nn5056496.html:text/html}
}

@article{browning2015largearea,
	title = {Large-area synthesis of {WSe} 2 from {WO} 3 by selenium{\textendash}oxygen ion exchange},
	volume = {2},
	issn = {2053-1583},
	url = {http://stacks.iop.org/2053-1583/2/i=1/a=014003},
	doi = {10.1088/2053-1583/2/1/014003},
	abstract = {Few-layer tungsten diselenide (WSe 2 ) is attractive as a next-generation electronic material as it exhibits modest carrier mobilities and energy band gap in the visible spectra, making it appealing for photovoltaic and low-powered electronic applications. Here we demonstrate the scalable synthesis of large-area, few-layer WSe 2 via replacement of oxygen in hexagonally stabilized tungsten oxide films using dimethyl selenium. Cross-sectional transmission electron microscopy reveals successful control of the final WSe 2 film thickness through control of initial tungsten oxide thickness, as well as development of layered films with grain sizes up to several hundred nanometers. Raman spectroscopy and atomic force microscopy confirms high crystal uniformity of the converted WSe 2 , and time domain thermo-reflectance provide evidence that near record low thermal conductivity is achievable in ultra-thin WSe 2 using this method.},
	language = {en},
	number = {1},
	urldate = {2016-09-19},
	journal = {2D Materials},
	author = {Browning, Paul and Eichfeld, Sarah and Zhang, Kehao and Hossain, Lorraine and Lin, Yu-Chuan and Wang, Ke and Lu, Ning and Waite, A. R. and Voevodin, A. A. and Kim, Moon and Robinson, Joshua A.},
	year = {2015},
	keywords = {Xsection},
	pages = {014003},
	file = {IOP Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/A74EXEUG/Browning et al. - 2015 - Large-area synthesis of WSe 2 from WO 3 by seleniu.pdf:application/pdf}
}

@article{lu2016atomicand,
	title = {Atomic and {Electronic} {Structures} of {WTe}2 {Probed} by {High} {Resolution} {Electron} {Microscopy} and ab {Initio} {Calculations}},
	volume = {120},
	issn = {1932-7447},
	url = {http://dx.doi.org/10.1021/acs.jpcc.6b01044},
	doi = {10.1021/acs.jpcc.6b01044},
	abstract = {Transition metal dichalcogenides (TMDs) are a class of two-dimensional (2D) materials that have attracted growing interest because of their unique electronic and optical properties. Under ambient conditions, most TMDs generally exhibit 2H or 1T structures. Unlike other group VIb TMDs, bulk crystals and powders of WTe2 exist in a distorted 1T structure (Td) at room temperature and have semimetallic properties. There is so far a lack of direct atom-by-atom visualization, limiting our understanding of this distorted 2D layered material system. We present herein atomic resolution images of Td structured WTe2. The Td structure can be distinguished in the three major orientations along the [100], [010], and [001] zone axes. Subtle structural distortions are detected by atomic resolution imaging, which match well with the optimized structure relaxed by ab initio calculations. The calculations also showed that both crystal field splitting and charge density wave (CDW) interactions contribute to the stabilization of WTe2. However, the CDW interaction dominates and leads the Td-WTe2 to be the most stable structure. The combined atomic resolution STEM and ab initio study on WTe2 provided the basis for understanding the correlations between atomic structure and electronic properties in Td structured TMD materials.},
	number = {15},
	urldate = {2016-09-19},
	journal = {The Journal of Physical Chemistry C},
	author = {Lu, Ning and Zhang, Chenxi and Lee, Chia-Hui and Oviedo, Juan Pablo and Nguyen, Minh An T. and Peng, Xin and Wallace, Robert M. and Mallouk, Thomas E. and Robinson, Joshua A. and Wang, Jinguo and Cho, Kyeongjae and Kim, Moon J.},
	month = apr,
	year = {2016},
	keywords = {Xsection},
	pages = {8364--8369},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/RGHX2SAP/Lu et al. - 2016 - Atomic and Electronic Structures of WTe2 Probed by.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/Z85UB5P4/acs.jpcc.html:text/html}
}

@article{vishwanath2016controllable,
	title = {Controllable growth of layered selenide and telluride heterostructures and superlattices using molecular beam epitaxy},
	volume = {31},
	issn = {0884-2914, 2044-5326},
	url = {https://www.cambridge.org/core/journals/journal-of-materials-research/article/controllable-growth-of-layered-selenide-and-telluride-heterostructures-and-superlattices-using-molecular-beam-epitaxy/00DE565960EFE1A8556F973BF832CB45},
	doi = {10.1557/jmr.2015.374},
	abstract = {Abstract, Layered materials are an actively pursued area of research for realizing highly scaled technologies involving both traditional device structures as well as new physics. Lately, non-equilibrium growth of 2D materials using molecular beam epitaxy (MBE) is gathering traction in the scientific community and here we aim to highlight one of its strengths, growth of abrupt heterostructures, and superlattices (SLs). In this work we present several of the firsts: first growth of MoTe2 by MBE, MoSe2 on Bi2Se3 SLs, transition metal dichalcogenide (TMD) SLs, and lateral junction between a quintuple atomic layer of Bi2Te3 and a triple atomic layer of MoTe2. Reflected high electron energy diffraction oscillations presented during the growth of TMD SLs strengthen our claim that ultrathin heterostructures with monolayer layer control is within reach.},
	number = {7},
	urldate = {2016-09-19},
	journal = {Journal of Materials Research},
	author = {Vishwanath, Suresh and Liu, Xinyu and Rouvimov, Sergei and Basile, Leonardo and Lu, Ning and Azcatl, Angelica and Magno, Katrina and Wallace, Robert M. and Kim, Moon and Idrobo, Juan-Carlos and Furdyna, Jacek K. and Jena, Debdeep and Xing, Huili Grace},
	month = apr,
	year = {2016},
	keywords = {Mo, molecular beam epitaxy (MBE), Te, Xsection},
	pages = {900--910},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/98ERG9N2/Vishwanath et al. - 2016 - Controllable growth of layered selenide and tellur.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/IVG37AJF/00DE565960EFE1A8556F973BF832CB45.html:text/html}
