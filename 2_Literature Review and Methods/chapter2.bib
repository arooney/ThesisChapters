	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/2GVDFI3X/Bonaccorso et al. - 2010 - Graphene photonics and optoelectronics.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9EDAERR9/nphoton.2010.186.html:text/html}
}

