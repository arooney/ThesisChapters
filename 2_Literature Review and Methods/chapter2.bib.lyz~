	url = {http://dx.doi.org/10.1021/acsnano.5b07807},
	doi = {10.1021/acsnano.5b07807},
	abstract = {Unique twisted bilayers of MoSe2 with multiple stacking orientations and interlayer couplings in the narrow range of twist angles, 60 {\textpm} 3{\textdegree}, are revealed by low-frequency Raman spectroscopy and theoretical analysis. The slight deviation from 60{\textdegree} allows the concomitant presence of patches featuring all three high-symmetry stacking configurations (2H or AA', AB', and A'B) in one unique bilayer system. In this case, the periodic arrangement of the patches and their size strongly depend on the twist angle. Ab initio modeling predicts significant changes in frequencies and intensities of low-frequency modes versus stacking and twist angle. Experimentally, the variable stacking and coupling across the interface are revealed by the appearance of two breathing modes, corresponding to the mixture of the high-symmetry stacking configurations and unaligned regions of monolayers. Only one breathing mode is observed outside the narrow range of twist angles. This indicates a stacking transition to unaligned monolayers with mismatched atom registry without the in-plane restoring force required to generate a shear mode. The variable interlayer coupling and spacing in transition metal dichalcogenide bilayers revealed in this study may provide an interesting platform for optoelectronic applications of these materials.},
	number = {2},
	urldate = {2016-08-04},
	journal = {ACS Nano},
	author = {Puretzky, Alexander A. and Liang, Liangbo and Li, Xufan and Xiao, Kai and Sumpter, Bobby G. and Meunier, Vincent and Geohegan, David B.},
	month = feb,
	year = {2016},
	pages = {2736--2744},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/W47KWZWQ/Puretzky et al. - 2016 - Twisted MoSe2 Bilayers with Variable Local Stackin.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/IBXBRMPV/acsnano.html:text/html}
