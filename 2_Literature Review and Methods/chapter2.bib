@article{zhang2014vertical,
	title = {Vertical {Heterostructures} of {Layered} {Metal} {Chalcogenides} by van der {Waals} {Epitaxy}},
	volume = {14},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl501000k},
	doi = {10.1021/nl501000k},
	abstract = {We report a facile chemical vapor deposition (CVD) growth of vertical heterostructures of layered metal dichalcogenides (MX2) enabled by van der Waals epitaxy. Few layers of MoS2, WS2, and WSe2 were grown uniformly onto microplates of SnS2 under mild CVD reaction conditions ({\textless}500 {\textdegree}C) and the heteroepitaxy between them was confirmed using cross-sectional transmission electron microscopy (TEM) and unequivocally characterized by resolving the large-area Moir{\'e} patterns that appeared on the basal planes of microplates in conventional TEM (nonsectioned). Additional photoluminescence peaks were observed in heterostructures of MoS2{\textendash}SnS2, which can be understood with electronic structure calculations to likely result from electronic coupling and charge separation between MoS2 and SnS2 layers. This work opens up the exploration of large-area heterostructures of diverse MX2 nanomaterials as the material platform for electronic structure engineering of atomically thin two-dimensional (2D) semiconducting heterostructures and device applications.},
	number = {6},
	urldate = {2016-09-18},
	journal = {Nano Letters},
	author = {Zhang, Xingwang and Meng, Fei and Christianson, Jeffrey R. and Arroyo-Torres, Christian and Lukowski, Mark A. and Liang, Dong and Schmidt, J. R. and Jin, Song},
	month = jun,
	year = {2014},
	keywords = {Xsection},
	pages = {3047--3054},
	file = {ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/GXTVDV3G/nl501000k.html:text/html}
}

