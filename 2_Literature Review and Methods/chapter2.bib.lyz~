	pages = {7287--7294},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/RACBQ8FW/Gong et al. - 2013 - Reversible Loss of Bernal Stacking during the Defo.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/ENDG243W/nn402830f.html:text/html}
