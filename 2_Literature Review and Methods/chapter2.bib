@article{chung2010transferable,
	title = {Transferable {GaN} {Layers} {Grown} on {ZnO}-{Coated} {Graphene} {Layers} for {Optoelectronic} {Devices}},
	volume = {330},
	copyright = {Copyright {\textcopyright} 2010, American Association for the Advancement of Science},
