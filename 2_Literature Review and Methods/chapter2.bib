	journal = {Journal of Controlled Release},
	author = {Goenka, Sumit and Sant, Vinayak and Sant, Shilpa},
	month = jan,
	year = {2014},
	keywords = {Cell{\textendash}material interactions, Drug delivery, Graphene nanomaterials, Tissue engineering},
	pages = {75--88},
	file = {ScienceDirect Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/SG2VDBNT/Goenka et al. - 2014 - Graphene-based nanomaterials for drug delivery and.pdf:application/pdf;ScienceDirect Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/J6ISPN5U/S016836591300847X.html:text/html}
}

