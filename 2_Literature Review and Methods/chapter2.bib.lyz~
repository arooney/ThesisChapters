	pages = {9243--9257},
	file = {ScienceDirect Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/PKRNRJG8/Liu et al. - 2013 - Graphene and graphene oxide as new nanocarriers fo.pdf:application/pdf;ScienceDirect Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/PUMCIXXP/S174270611300408X.html:text/html}
}

