	keywords = {effective-mass, Hexagonal boron-nitride, silicon},
	pages = {279--284}
}

@article{banerjee2009bilayer,
	title = {Bilayer {PseudoSpin} {Field}-{Effect} {Transistor} ({BiSFET}): {A} {Proposed} {New} {Logic} {Device}},
