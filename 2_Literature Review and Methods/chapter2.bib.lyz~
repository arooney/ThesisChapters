	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/SMQZ4N7I/Hsu et al. - 2014 - Second Harmonic Generation from Artificially Stack.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/XSWHGKN7/nn500228r.html:text/html}
