	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/GPDGH77M/Yan et al. - 2013 - Damping pathways of mid-infrared plasmons in graph.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/8A4V5BG2/nphoton.2013.57.html:text/html}
