	number = {6004},
	urldate = {2016-08-12},
	journal = {Science},
	author = {Chung, Kunook and Lee, Chul-Ho and Yi, Gyu-Chul},
	month = oct,
	year = {2010},
	pmid = {21030653},
	pages = {655--657},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/CN7R6MF3/Chung et al. - 2010 - Transferable GaN Layers Grown on ZnO-Coated Graphe.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/GMAJUZWG/655.html:text/html}
