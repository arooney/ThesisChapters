@article{britnell2012fieldeffect,
	title = {Field-{Effect} {Tunneling} {Transistor} {Based} on {Vertical} {Graphene} {Heterostructures}},
	volume = {335},
	shorttitle = {Field-{Effect} {Tunneling} {Transistor} {Based} on {Vertical} {Graphene} {Heterostructures}},
