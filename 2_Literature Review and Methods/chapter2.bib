	month = dec,
	year = {2014},
	keywords = {Two-dimensional materials},
	pages = {1135--1142},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/99ADP8ZS/Gong et al. - 2014 - Vertical and in-plane heterostructures from WS2Mo.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/A2SWTCMZ/nmat4091.html:text/html}
