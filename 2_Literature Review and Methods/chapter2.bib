	issn = {0003-6951, 1077-3118},
	url = {http://scitation.aip.org/content/aip/journal/apl/108/20/10.1063/1.4950969},
	doi = {10.1063/1.4950969},
	abstract = {We explored single-layer graphene and graphene field-effect transistors immersed in nitric acid using in-situ Raman spectroscopy. Two distinct stages were observed in the chemical doping process. The first stage involved blue shifts of the G and 2D peaks, whose saturation occurred rapidly with a time constant in the range of 10{\textendash}25 s depending on the molar concentration of the acid. In the second stage, the intensity of the D peak, which was associated with structural defect formation, increased for a relatively long period of time. Since the major doping effects appeared during the first stage, the optimal doping conditions under which no noticeable structural defect formation occurred can be determined by monitoring the frequency shift. Transient doping concentrations along with structural defect densities were obtained from the Raman peak positions and intensities. We found that the doping-induced shift in the Dirac point in graphene field-effect transistors exhibited a fast response with respect to frequency shifts in the Raman spectra, which was attributed to the saturation of electrostatic gating effects.},
	number = {20},
	urldate = {2016-09-12},
	journal = {Applied Physics Letters},
	author = {Kim, S. J. and Park, S. J. and Kim, H. Y. and Jang, G. S. and Park, D. J. and Park, Ji-Yong and Lee, Soonil and Ahn, Y. H.},
	month = may,
	year = {2016},
	keywords = {Acids, Doping, Field effect transistors, Graphene, Raman spectra},
	pages = {203111},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/K7PWTTW2/Kim et al. - 2016 - Characterization of chemical doping of graphene by.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/AM3JRAP5/1.html:text/html}
}

@article{takahashi2012insitu,
