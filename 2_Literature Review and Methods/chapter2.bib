	pages = {5129--5134},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/AU8M55UI/Bogaert et al. - 2016 - Diffusion-Mediated Synthesis of MoS2WS2 Lateral H.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/MXF528MK/acs.nanolett.html:text/html}
}

@article{konstantatos2012hybridgraphenequantum,
	title = {Hybrid graphene-quantum dot phototransistors with ultrahigh gain},
	volume = {7},
	copyright = {{\textcopyright} 2012 Nature Publishing Group},
