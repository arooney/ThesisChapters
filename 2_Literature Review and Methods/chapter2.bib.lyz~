	keywords = {Synthesis of graphene},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/NRF9GTDS/Xu et al. - 2016 - Ultrafast growth of single-crystal graphene assist.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/RTCI63Z5/nnano.2016.132.html:text/html}
