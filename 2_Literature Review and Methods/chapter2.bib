	pages = {115501},
	file = {APS Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/VG4RGDEU/PhysRevLett.113.html:text/html;Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/KS37X67B/Susi et al. - 2014 - Siliconchar21 Carbon Bond Inversions Driven by 6.pdf:application/pdf}
}

