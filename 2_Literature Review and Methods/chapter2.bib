@article{roy2014fieldeffect,
	title = {Field-{Effect} {Transistors} {Built} from {All} {Two}-{Dimensional} {Material} {Components}},
	volume = {8},
	issn = {1936-0851},
	url = {http://dx.doi.org/10.1021/nn501723y},
	doi = {10.1021/nn501723y},
	abstract = {We demonstrate field-effect transistors using heterogeneously stacked two-dimensional materials for all of the components, including the semiconductor, insulator, and metal layers. Specifically, MoS2 is used as the active channel material, hexagonal-BN as the top-gate dielectric, and graphene as the source/drain and the top-gate contacts. This transistor exhibits n-type behavior with an ON/OFF current ratio of {\textgreater}106, and an electron mobility of \~{}33 cm2/V{\textperiodcentered}s. Uniquely, the mobility does not degrade at high gate voltages, presenting an important advantage over conventional Si transistors where enhanced surface roughness scattering severely reduces carrier mobilities at high gate-fields. A WSe2{\textendash}MoS2 diode with graphene contacts is also demonstrated. The diode exhibits excellent rectification behavior and a low reverse bias current, suggesting high quality interfaces between the stacked layers. In this work, all interfaces are based on van der Waals bonding, presenting a unique device architecture where crystalline, layered materials with atomically uniform thicknesses are stacked on demand, without the lattice parameter constraints. The results demonstrate the promise of using an all-layered material system for future electronic applications.},
	number = {6},
	urldate = {2016-08-11},
	journal = {ACS Nano},
	author = {Roy, Tania and Tosun, Mahmut and Kang, Jeong Seuk and Sachid, Angada B. and Desai, Sujay B. and Hettick, Mark and Hu, Chenming C. and Javey, Ali},
	month = jun,
	year = {2014},
	pages = {6259--6264},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/SAVVZ4GD/Roy et al. - 2014 - Field-Effect Transistors Built from All Two-Dimens.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/DXMQ4WRQ/nn501723y.html:text/html}
}

@article{yang2012graphene,
	title = {Graphene {Barristor}, a {Triode} {Device} with a {Gate}-{Controlled} {Schottky} {Barrier}},
	volume = {336},
	copyright = {Copyright {\textcopyright} 2012, American Association for the Advancement of Science},
	issn = {0036-8075, 1095-9203},
	url = {http://science.sciencemag.org/content/336/6085/1140},
	doi = {10.1126/science.1220527},
	abstract = {Despite several years of research into graphene electronics, sufficient on/off current ratio Ion/Ioff in graphene transistors with conventional device structures has been impossible to obtain. We report on a three-terminal active device, a graphene variable-barrier {\textquotedblleft}barristor{\textquotedblright} (GB), in which the key is an atomically sharp interface between graphene and hydrogenated silicon. Large modulation on the device current (on/off ratio of 105) is achieved by adjusting the gate voltage to control the graphene-silicon Schottky barrier. The absence of Fermi-level pinning at the interface allows the barrier{\textquoteright}s height to be tuned to 0.2 electron volt by adjusting graphene{\textquoteright}s work function, which results in large shifts of diode threshold voltages. Fabricating GBs on respective 150-mm wafers and combining complementary p- and n-type GBs, we demonstrate inverter and half-adder logic circuits.
The absence of defects and surface oxides at a graphene/silicon interface enables voltage control of graphene devices.
The absence of defects and surface oxides at a graphene/silicon interface enables voltage control of graphene devices.},
	language = {en},
	number = {6085},
	urldate = {2016-08-11},
	journal = {Science},
	author = {Yang, Heejun and Heo, Jinseong and Park, Seongjun and Song, Hyun Jae and Seo, David H. and Byun, Kyung-Eun and Kim, Philip and Yoo, InKyeong and Chung, Hyun-Jong and Kim, Kinam},
	month = jun,
	year = {2012},
	pmid = {22604723},
	pages = {1140--1143},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/ZBBA2TKS/Yang et al. - 2012 - Graphene Barristor, a Triode Device with a Gate-Co.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/WKKFA43M/1140.html:text/html}
}

@article{thayne2009reviewof,
