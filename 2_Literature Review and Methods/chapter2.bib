	journal = {Science Advances},
	author = {Banszerus, Luca and Schmitz, Michael and Engels, Stephan and Dauber, Jan and Oellers, Martin and Haupt, Federica and Watanabe, Kenji and Taniguchi, Takashi and Beschoten, Bernd and Stampfer, Christoph},
	month = jul,
	year = {2015},
	pages = {e1500222},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/IJIJQMKG/Banszerus et al. - 2015 - Ultrahigh-mobility graphene devices from chemical .pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/PMVMTD6N/e1500222.html:text/html}
}