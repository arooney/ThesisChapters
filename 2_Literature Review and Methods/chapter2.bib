@article{cao2015quality,
	title = {Quality {Heterostructures} from {Two}-{Dimensional} {Crystals} {Unstable} in {Air} by {Their} {Assembly} in {Inert} {Atmosphere}},
	volume = {15},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/acs.nanolett.5b00648},
	doi = {10.1021/acs.nanolett.5b00648},
	abstract = {Many layered materials can be cleaved down to individual atomic planes, similar to graphene, but only a small minority of them are stable under ambient conditions. The rest react and decompose in air, which has severely hindered their investigation and potential applications. Here we introduce a remedial approach based on cleavage, transfer, alignment, and encapsulation of air-sensitive crystals, all inside a controlled inert atmosphere. To illustrate the technology, we choose two archetypal two-dimensional crystals that are of intense scientific interest but are unstable in air: black phosphorus and niobium diselenide. Our field-effect devices made from their monolayers are conductive and fully stable under ambient conditions, which is in contrast to the counterparts processed in air. NbSe2 remains superconducting down to the monolayer thickness. Starting with a trilayer, phosphorene devices reach sufficiently high mobilities to exhibit Landau quantization. The approach offers a venue to significantly expand the range of experimentally accessible two-dimensional crystals and their heterostructures.},
	number = {8},
	urldate = {2015-09-25},
	journal = {Nano Letters},
	author = {Cao, Y. and Mishchenko, A. and Yu, G. L. and Khestanova, E. and Rooney, A. P. and Prestat, E. and Kretinin, A. V. and Blake, P. and Shalom, M. B. and Woods, C. and Chapman, J. and Balakrishnan, G. and Grigorieva, I. V. and Novoselov, K. S. and Piot, B. A. and Potemski, M. and Watanabe, K. and Taniguchi, T. and Haigh, S. J. and Geim, A. K. and Gorbachev, R. V.},
	month = aug,
	year = {2015},
	pages = {4914--4921},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/CJDKDF6J/Cao et al. - 2015 - Quality Heterostructures from Two-Dimensional Crys.pdf:application/pdf;ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/AB8N3RSG/Cao et al. - 2015 - Quality Heterostructures from Two-Dimensional Crys.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/Z7EVQGWB/Cao et al. - 2015 - Quality Heterostructures from Two-Dimensional Crys.html:text/html;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/HVKGEXWI/acs.nanolett.html:text/html}
