@article{guan2014tilingphosphorene,
	title = {Tiling {Phosphorene}},
	volume = {8},
	issn = {1936-0851},
	url = {http://dx.doi.org/10.1021/nn5059248},
	doi = {10.1021/nn5059248},
	abstract = {We present a scheme to categorize the structure of different layered phosphorene allotropes by mapping their nonplanar atomic structure onto a two-color 2D triangular tiling pattern. In the buckled structure of a phosphorene monolayer, we assign atoms in ?top? positions to dark tiles and atoms in ?bottom? positions to light tiles. Optimum sp3 bonding is maintained throughout the structure when each triangular tile is surrounded by the same number N of like-colored tiles, with 0 <= N <= 2. Our ab initio density functional calculations indicate that both the relative stability and electronic properties depend primarily on the structural index N. The proposed mapping approach may also be applied to phosphorene structures with nonhexagonal rings and 2D quasicrystals with no translational symmetry, which we predict to be nearly as stable as the hexagonal network.},
	number = {12},
	urldate = {2015-09-11},
	journal = {ACS Nano},
	author = {Guan, Jie and Zhu, Zhen and Tom{\'a}nek, David},
	month = dec,
	year = {2014},
	pages = {12763--12768},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/48SD4BGZ/Guan et al. - 2014 - Tiling Phosphorene.pdf:application/pdf;ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/SBNUV2D8/Guan et al. - 2014 - Tiling Phosphorene.pdf:;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/4JMUB5BZ/nn5059248.html:text/html;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/AUKBI32J/nn5059248.html:}
}

@article{valevs2015ramanspectroscopy,
	title = {Raman spectroscopy and {AFM} study of 12C graphene/fullerenes {C}70/13C graphene heterostructure},
	volume = {252},
	issn = {1521-3951},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/pssb.201552235/abstract},
	doi = {10.1002/pssb.201552235},
	abstract = {In our study, we sandwiched fullerenes C70 in between two layers of isotopically labeled graphene and studied this heterostructure by atomic force microscopy and by Raman spectroscopy. Isotope labeling was used to distinguish between the top and the bottom graphene layers in the measured Raman spectra. We analyzed the Raman maps of isotopically labeled graphene{\textendash}fullerene heterostructures and described the effect of the fullerenes on graphene layers. Apart from the peak parameters obtained directly from fitting the principal Raman modes of graphene, we evaluated strain and doping in both layers employing a correlation analysis of the positions of the G and the 2D bands. Our results show that the top layer is less doped and contains less sub-micron charge inhomogeneities than the bottom layer.},
	language = {en},
	number = {11},
	urldate = {2016-09-13},
