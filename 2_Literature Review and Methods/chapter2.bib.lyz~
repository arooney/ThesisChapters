@article{chen2008intrinsic,
	title = {Intrinsic and extrinsic performance limits of graphene devices on {SiO}2},
	volume = {3},
	copyright = {{\textcopyright} 2008 Nature Publishing Group},
	issn = {1748-3387},
	url = {http://www.nature.com/nnano/journal/v3/n4/full/nnano.2008.58.html},
	doi = {10.1038/nnano.2008.58},
	abstract = {The linear dispersion relation in graphene gives rise to a surprising prediction: the resistivity due to isotropic scatterers, such as white-noise disorder or phonons, is independent of carrier density, n. Here we show that electron{\textendash}acoustic phonon scattering is indeed independent of n, and contributes only 30 $\Omega$ to graphene's room-temperature resistivity. At a technologically relevant carrier density of 1 {\texttimes}1012 cm-2, we infer a mean free path for electron{\textendash}acoustic phonon scattering of {\textgreater}2 {\textmu}m and an intrinsic mobility limit of 2 {\texttimes} 105 cm2 V-1 s-1. If realized, this mobility would exceed that of InSb, the inorganic semiconductor with the highest known mobility ({\textasciitilde}7.7 {\texttimes} 104 cm2 V-1 s-1; ref. 9) and that of semiconducting carbon nanotubes ({\textasciitilde}1 {\texttimes} 105 cm2 V-1 s-1; ref. 10). A strongly temperature-dependent resistivity contribution is observed above {\textasciitilde}200 K (ref. 8); its magnitude, temperature dependence and carrier-density dependence are consistent with extrinsic scattering by surface phonons at the SiO2 substrate and limit the room-temperature mobility to {\textasciitilde}4 {\texttimes} 104 cm2 V-1 s-1, indicating the importance of substrate choice for graphene devices.},
	language = {en},
	number = {4},
	urldate = {2016-08-02},
	journal = {Nature Nanotechnology},
	author = {Chen, Jian-Hao and Jang, Chaun and Xiao, Shudong and Ishigami, Masa and Fuhrer, Michael S.},
	month = apr,
	year = {2008},
	pages = {206--209},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/6QQRCDZS/Chen et al. - 2008 - Intrinsic and extrinsic performance limits of grap.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/J4W23GXM/nnano.2008.58.html:text/html}
}

@article{bolotin2008ultrahigh,
	title = {Ultrahigh electron mobility in suspended graphene},
	volume = {146},
	issn = {0038-1098},
	url = {http://www.sciencedirect.com/science/article/pii/S0038109808001178},
	doi = {10.1016/j.ssc.2008.02.024},
	abstract = {We have achieved mobilities in excess of 200,000~cm2~V -1~s-1 at electron densities of \~{}2 {\texttimes}1011~cm-2 by suspending single layer graphene. Suspension \~{}150~nm above a Si/SiO2 gate electrode and electrical contacts to the graphene was achieved by a combination of electron beam lithography and etching. The specimens were cleaned in situ by employing current-induced heating, directly resulting in a significant improvement of electrical transport. Concomitant with large mobility enhancement, the widths of the characteristic Dirac peaks are reduced by a factor of 10 compared to traditional, nonsuspended devices. This advance should allow for accessing the intrinsic transport properties of graphene.},
	number = {9{\textendash}10},
	urldate = {2016-08-02},
	journal = {Solid State Communications},
	author = {Bolotin, K. I. and Sikes, K. J. and Jiang, Z. and Klima, M. and Fudenberg, G. and Hone, J. and Kim, P. and Stormer, H. L.},
	month = jun,
	year = {2008},
	keywords = {A. Graphene, B. Nanofabrication, D. Electronic transport},
	pages = {351--355},
	file = {ScienceDirect Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/9MNECUQX/Bolotin et al. - 2008 - Ultrahigh electron mobility in suspended graphene.pdf:application/pdf;ScienceDirect Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/KT68UNHJ/S0038109808001178.html:text/html}
}

@article{blake2007makinggraphene,
	title = {Making graphene visible},
	volume = {91},
	issn = {0003-6951},
	shorttitle = {Making graphene visible},
	url = {://WOS:000248661400130 http://scitation.aip.org/getpdf/servlet/GetPDFServlet?filetype=pdf&id=APPLAB000091000006063124000001&idtype=cvips&doi=10.1063/1.2768624&prog=normal},
	doi = {10.1063/1.2768624},
	abstract = {Microfabrication of graphene devices used in many experimental studies currently relies on the fact that graphene crystallites can be visualized using optical microscopy if prepared on top of Si wafers with a certain thickness of SiO2. The authors study graphene's visibility and show that it depends strongly on both thickness of SiO2 and light wavelength. They have found that by using monochromatic illumination, graphene can be isolated for any SiO2 thickness, albeit 300 nm (the current standard) and, especially, approximate to 100 nm are most suitable for its visual detection. By using a Fresnel-law-based model, they quantitatively describe the experimental data. (c) 2007 American Institute of Physics.},
	language = {English},
	number = {6},
	journal = {Applied Physics Letters},
	author = {Blake, P. and Hill, E. W. and Neto, A. H. C. and Novoselov, K. S. and Jiang, D. and Yang, R. and Booth, T. J. and Geim, A. K.},
	month = aug,
	year = {2007},
	keywords = {films},
	file = {Blake-2007-Making graphene visi.pdf:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/R7JNBIJB/Blake-2007-Making graphene visi.pdf:application/pdf}
}