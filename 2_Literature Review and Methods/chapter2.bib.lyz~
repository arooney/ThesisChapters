	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/HT4SRK45/Cheng et al. - 2016 - van der Waals Heterojunction Devices Based on Orga.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/8H4AHK5K/acs.nanolett.html:text/html}
