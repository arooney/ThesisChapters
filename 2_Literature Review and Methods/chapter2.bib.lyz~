	month = oct,
	year = {2011},
	keywords = {Electronic properties and devices, Metamaterials, Nanophotonics and plasmonics},
	pages = {630--634},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/A4Q28SSK/Ju et al. - 2011 - Graphene plasmonics for tunable terahertz metamate.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/ZU3BFNK8/nnano.2011.146.html:text/html}
