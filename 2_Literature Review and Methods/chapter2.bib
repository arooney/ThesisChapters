	url = {http://stacks.iop.org/0268-1242/29/i=6/a=064009},
	doi = {10.1088/0268-1242/29/6/064009},
	abstract = {Graphene, a one-atom-layer carbon material, can be grown by thermal decomposition of SiC. On Si-terminated SiC(0001), graphene nucleates at steps and grows layer-by-layer, and as a result a homogeneous monolayer or bilayer can be obtained. We demonstrate this mechanism both experimentally and theoretically. On the C-face (000 \#\#IMG\#\# [http://ej.iop.org/images/0268-1242/29/6/064009/sst491083ieqn1.gif] \${\textbackslash}bar 1\$ ), multilayer graphene nucleates not only at steps, but also on the terraces. These differences reflect the distinct differences in the reactivity of these faces. Due to its high quality and structural controllability, graphene on SiC0001 surfaces will be a platform for high-speed graphene device applications.},
	language = {en},
	number = {6},
	urldate = {2016-08-09},
	journal = {Semiconductor Science and Technology},
	author = {Norimatsu, Wataru and Kusunoki, Michiko},
