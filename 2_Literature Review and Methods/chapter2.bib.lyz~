	pages = {5660--5665},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/C3CPM2BT/Kim et al. - 2013 - Stacking Order Dependent Second Harmonic Generatio.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/PUNR7ZF5/nl403328s.html:text/html}
}

