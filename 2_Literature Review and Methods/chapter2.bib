@article{gorbachev2014detecting,
	title = {Detecting topological currents in graphene superlattices},
	volume = {346},
	copyright = {Copyright {\textcopyright} 2014, American Association for the Advancement of Science},
	issn = {0036-8075, 1095-9203},
	url = {http://science.sciencemag.org/content/346/6208/448},
	doi = {10.1126/science.1254966},
	abstract = {Making use of graphene's valleys
Graphene has two distinct valleys in its electronic structure, in which the electrons have the same energy. Theorists have predicted that creating an asymmetry between the two valleys will coax graphene into exhibiting the so-called valley Hall effect (VHE). In this effect, electrons from the two valleys move across the sample in opposite directions when the experimenters run current along the sample. Gorbachev et al. achieved this asymmetry by aligning graphene with an underlying layer of hexagonalboron nitride (hBN) (see the Perspective by Lundeberg and Folk). The authors measured the transport characteristics of the sample, which were consistent with the theoretical predictions for the VHE. The method may in the future lead to information processing using graphene's valleys.
Science, this issue p. 448; see also p. 422
Topological materials may exhibit Hall-like currents flowing transversely to the applied electric field even in the absence of a magnetic field. In graphene superlattices, which have broken inversion symmetry, topological currents originating from graphene{\textquoteright}s two valleys are predicted to flow in opposite directions and combine to produce long-range charge neutral flow. We observed this effect as a nonlocal voltage at zero magnetic field in a narrow energy range near Dirac points at distances as large as several micrometers away from the nominal current path. Locally, topological currents are comparable in strength with the applied current, indicating large valley-Hall angles. The long-range character of topological currents and their transistor-like control by means of gate voltage can be exploited for information processing based on valley degrees of freedom.
Graphene is aligned with a layer of hexagonal boron nitride to achieve the valley Hall effect. [Also see Perspective by Lundeberg and Folk]
Graphene is aligned with a layer of hexagonal boron nitride to achieve the valley Hall effect. [Also see Perspective by Lundeberg and Folk]},
	language = {en},
	number = {6208},
	urldate = {2016-08-03},
	journal = {Science},
	author = {Gorbachev, R. V. and Song, J. C. W. and Yu, G. L. and Kretinin, A. V. and Withers, F. and Cao, Y. and Mishchenko, A. and Grigorieva, I. V. and Novoselov, K. S. and Levitov, L. S. and Geim, A. K.},
	month = oct,
	year = {2014},
	pmid = {25342798},
	pages = {448--451},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/WW4WPDFF/Gorbachev et al. - 2014 - Detecting topological currents in graphene superla.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/4UQVAJQ3/448.html:text/html}
}

