	month = jun,
	year = {2008},
	pmid = {18388259},
	pages = {1308--1308},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/H7M8BC5U/Nair et al. - 2008 - Fine Structure Constant Defines Visual Transparenc.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/JDJI9VT4/1308.html:text/html}
}

@article{huang2012graphenebased,
