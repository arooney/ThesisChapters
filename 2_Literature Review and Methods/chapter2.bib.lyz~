@article{zaretski2015processes,
	title = {Processes for non-destructive transfer of graphene: widening the bottleneck for industrial scale production},
	volume = {7},
	issn = {2040-3372},
	shorttitle = {Processes for non-destructive transfer of graphene},
	url = {http://pubs.rsc.org/en/content/articlelanding/2015/nr/c5nr01777g},
	doi = {10.1039/C5NR01777G},
	abstract = {The exceptional charge-transport, mechanical, and barrier properties of graphene are well known. High-quality films of single-layer graphene produced over large areas, however, are extremely expensive. The high cost of graphene precludes its use in industries{\textemdash}such as transparent electrodes and flexible packaging{\textemdash}that might take full advantage of its properties. This minireview presents several strategies for the transfer of graphene from the substrates used for growth to substrates used for the final application. Each strategy shares the characteristic of being non-destructive: that is, the growth substrate remains reusable for further synthesis of new graphene. These processes have the potential to lower significantly the costs of manufacturing graphene, to increase production yields, and to minimize environmental impact. This article is divided into sections on (i) the synthesis of high-quality single-layer graphene and (ii) its non-destructive transfer to a host substrate. Section (ii) is further divided according to the substrate from which graphene is transferred: single-crystalline wafers or flexible copper foils. We also comment, wherever possible, on defects produced as a result of the transfer, and potential strategies to mitigate these defects. We conclude that several methods for the green synthesis and transfer of graphene have several of the right characteristics to be useful in industrial scale production.},
	language = {en},
	number = {22},
	urldate = {2016-08-08},
	journal = {Nanoscale},
	author = {Zaretski, Aliaksandr V. and Lipomi, Darren J.},
	month = may,
	year = {2015},
	pages = {9963--9969},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/G75ZWKD8/Zaretski and Lipomi - 2015 - Processes for non-destructive transfer of graphene.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/WI77U9G8/C5NR01777G.html:text/html}
}

@article{huang2011grainsand,
