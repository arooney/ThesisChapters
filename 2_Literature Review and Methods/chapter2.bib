	keywords = {Electron energy-loss spectroscopy (EELS), Inelastic mean free path, Thickness measurement},
	pages = {193--200},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/E6M876MT/Malis et al. - 1988 - EELS log-ratio technique for specimen-thickness me.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/GAQSR8Q2/abstract.html:text/html}
}

