@article{zhu2014semiconducting,
	title = {Semiconducting {Layered} {Blue} {Phosphorus}: {A} {Computational} {Study}},
	volume = {112},
	shorttitle = {Semiconducting {Layered} {Blue} {Phosphorus}},
