@article{pierucci2016bandalignment,
	title = {Band {Alignment} and {Minigaps} in {Monolayer} {MoS}2-{Graphene} van der {Waals} {Heterostructures}},
	volume = {16},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/acs.nanolett.6b00609},
	doi = {10.1021/acs.nanolett.6b00609},
	abstract = {Two-dimensional layered MoS2 shows great potential for nanoelectronic and optoelectronic devices due to its high photosensitivity, which is the result of its indirect to direct band gap transition when the bulk dimension is reduced to a single monolayer. Here, we present an exhaustive study of the band alignment and relativistic properties of a van der Waals heterostructure formed between single layers of MoS2 and graphene. A sharp, high-quality MoS2-graphene interface was obtained and characterized by micro-Raman spectroscopy, high-resolution X-ray photoemission spectroscopy (HRXPS), and scanning high-resolution transmission electron microscopy (STEM/HRTEM). Moreover, direct band structure determination of the MoS2/graphene van der Waals heterostructure monolayer was carried out using angle-resolved photoemission spectroscopy (ARPES), shedding light on essential features such as doping, Fermi velocity, hybridization, and band-offset of the low energy electronic dynamics found at the interface. We show that, close to the Fermi level, graphene exhibits a robust, almost perfect, gapless, and n-doped Dirac cone and no significant charge transfer doping is detected from MoS2 to graphene. However, modification of the graphene band structure occurs at rather larger binding energies, as the opening of several miniband-gaps is observed. These miniband-gaps resulting from the overlay of MoS2 and the graphene layer lattice impose a superperiodic potential.},
	number = {7},
	urldate = {2016-08-21},
	journal = {Nano Letters},
	author = {Pierucci, Debora and Henck, Hugo and Avila, Jose and Balan, Adrian and Naylor, Carl H. and Patriarche, Gilles and Dappe, Yannick J. and Silly, Mathieu G. and Sirotti, Fausto and Johnson, A. T. Charlie and Asensio, Maria C. and Ouerghi, Abdelkarim},
	month = jul,
	year = {2016},
	keywords = {CharHeteros, Xsection},
	pages = {4054--4061},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/PP5MPB62/Pierucci et al. - 2016 - Band Alignment and Minigaps in Monolayer MoS2-Grap.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/4AMQUPN9/acs.nanolett.html:text/html}
}

@article{liu2015towardbarrier,
	title = {Toward {Barrier} {Free} {Contact} to {Molybdenum} {Disulfide} {Using} {Graphene} {Electrodes}},
	volume = {15},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl504957p},
	doi = {10.1021/nl504957p},
	abstract = {Two-dimensional layered semiconductors such as molybdenum disulfide (MoS2) have attracted tremendous interest as a new class of electronic materials. However, there are considerable challenges in making reliable contacts to these atomically thin materials. Here we present a new strategy by using graphene as the back electrodes to achieve ohmic contact to MoS2. With a finite density of states, the Fermi level of graphene can be readily tuned by a gate potential to enable a nearly perfect band alignment with MoS2. We demonstrate for the first time a transparent contact to MoS2 with zero contact barrier and linear output behavior at cryogenic temperatures (down to 1.9 K) for both monolayer and multilayer MoS2. Benefiting from the barrier-free transparent contacts, we show that a metal{\textendash}insulator transition can be observed in a two-terminal MoS2 device, a phenomenon that could be easily masked by Schottky barriers found in conventional metal-contacted MoS2 devices. With further passivation by boron nitride (BN) encapsulation, we demonstrate a record-high extrinsic (two-terminal) field effect mobility up to 1300 cm2/(V s) in MoS2 at low temperature.},
	number = {5},
	urldate = {2016-09-19},
	journal = {Nano Letters},
	author = {Liu, Yuan and Wu, Hao and Cheng, Hung-Chieh and Yang, Sen and Zhu, Enbo and He, Qiyuan and Ding, Mengning and Li, Dehui and Guo, Jian and Weiss, Nathan O. and Huang, Yu and Duan, Xiangfeng},
	month = may,
	year = {2015},
	keywords = {Xsection},
	pages = {3030--3034},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/E72MB2D2/Liu et al. - 2015 - Toward Barrier Free Contact to Molybdenum Disulfid.pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/6K2WWKAN/nl504957p.html:text/html}
}

@article{sutter2013scalable2,
	title = {Scalable {Synthesis} of {Uniform} {Few}-{Layer} {Hexagonal} {Boron} {Nitride} {Dielectric} {Films}},
	volume = {13},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl304080y},
	doi = {10.1021/nl304080y},
	abstract = {Two-dimensional or ultrathin layered materials are attracting broad interest in both fundamental science and applications. While exfoliation can provide high-quality single- and few-layer flakes with nanometer to micrometer size, the development of wafer-scale synthesis methods is important for realizing the full potential of ultrathin layered materials. Here we demonstrate the growth of high quality few-layer boron nitride (BN) films with controlled thickness by magnetron sputtering of B in N2/Ar, a scalable process using only benign, nontoxic reagents. BN films up to two atomic layers are synthesized by reactive deposition at high substrate temperatures. Thicker monocrystalline BN films with an arbitrary number of atomic layers are achieved in a two-step process comprising cycles of alternating room temperature deposition and annealing. Tunneling transport across these BN films shows pinhole-free insulating behavior on $\mu$m2 scales, demonstrating the realization of high quality ultrathin dielectrics.},
	number = {1},
	urldate = {2016-08-15},
	journal = {Nano Letters},
	author = {Sutter, P. and Lahiri, J. and Zahl, P. and Wang, B. and Sutter, E.},
	month = jan,
	year = {2013},
	keywords = {CharHeteros, Xsection},
	pages = {276--281},
	file = {ACS Full Text PDF w/ Links:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/GK7IRPCU/Sutter et al. - 2013 - Scalable Synthesis of Uniform Few-Layer Hexagonal .pdf:application/pdf;ACS Full Text Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/V6I8IEPS/nl304080y.html:text/html}
}

