	pmid = {24127582},
	keywords = {CVD graphene, glass transition, sheet resistance},
	pages = {17762--17767},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/ZH7BRTT7/Martins et al. - 2013 - Direct transfer of graphene onto flexible substrat.pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/5TU8MQ2I/17762.html:text/html}
}

@article{martinsferreira2010evolution,
	title = {Evolution of the {Raman} spectra from single-, few-, and many-layer graphene with increasing disorder},
	volume = {82},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.82.125429},
