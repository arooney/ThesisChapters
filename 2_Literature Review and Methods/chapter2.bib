	month = jun,
	year = {2012},
	keywords = {Graphene, Optoelectronic devices and components, Quantum dots},
	pages = {363--368},
	file = {Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/CX8NWIFV/Konstantatos et al. - 2012 - Hybrid graphene-quantum dot phototransistors with .pdf:application/pdf;Snapshot:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/RSZJHEVC/nnano.2012.60.html:text/html}
