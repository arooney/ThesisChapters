@article{castroneto2009theelectronic,
	title = {The electronic properties of graphene},
	volume = {81},
	issn = {0034-6861},
	shorttitle = {The electronic properties of graphene},
	url = {://WOS:000264764600004 http://rmp.aps.org/pdf/RMP/v81/i1/p109_1},
