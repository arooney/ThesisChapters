	author = {Wang, L. and Meric, I. and Huang, P. Y. and Gao, Q. and Gao, Y. and Tran, H. and Taniguchi, T. and Watanabe, K. and Campos, L. M. and Muller, D. A. and Guo, J. and Kim, P. and Hone, J. and Shepard, K. L. and Dean, C. R.},
