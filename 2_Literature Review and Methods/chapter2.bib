	file = {IOP Full Text PDF:/home/arooney/.zotero/zotero/nuawj0t0.default/zotero/storage/62D963M8/D{\'a}vila et al. - 2014 - Germanene a novel two-dimensional germanium allot.pdf:application/pdf}
}

